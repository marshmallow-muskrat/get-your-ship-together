{
  "name": "get-your-ship-together",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "bench:doc": "vite-node scripts/genBenchDoc.ts",
    "bench:survival": "vite-node scripts/genSurvivalBenchDoc.ts",
    "bench:repair": "vite-node scripts/genRepairBenchDoc.ts",
    "bench:bossdamage": "vite-node scripts/genBossDamageDoc.ts"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "0.180.0",
    "eslint": "^10.8.1",
    "playwright": "^1.56.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
